server {
    listen 80;
    server_name localhost;

    # Header pour identifier la version active (debug)
    add_header X-Active-Color ${ACTIVE_COLOR} always;

    # Route API vers le backend actif
    location /api {
        proxy_pass http://${ACTIVE_COLOR}_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 30s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    # Route tout le reste vers le frontend actif
    location / {
        proxy_pass http://${ACTIVE_COLOR}_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Health check endpoint
    location /nginx-health {
        access_log off;
        return 200 "healthy - active: ${ACTIVE_COLOR}\n";
        add_header Content-Type text/plain;
    }
}
